{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"types": ["bun"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "test", "dev.ts", "build.ts", "generate-check.ts"]
}
